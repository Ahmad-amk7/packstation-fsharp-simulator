<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <h5>Aktion erforderlich</h5>
                <p>Haben Sie das Paket entnommen?</p>
                
                <form asp-action="ConfirmReceived" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-lg w-100">✅ Paket entnommen - Fach schließen</button>
                </form>
                
                <form asp-action="AutoClose" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning w-100">Fach automatisch schließen (Timeout)</button>
                </form>
            </div>
        </div>
    </div>
</div>

