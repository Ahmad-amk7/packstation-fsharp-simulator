@{
    ViewData["Title"] = "Fach öffnen";
}

<h2>ðŸ“¦ Packstation - Fach öffnen</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning">
                <h5>Abholcode eingeben</h5>
            </div>
            <div class="card-body">
                <form asp-action="Open" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label class="control-label">6-stelliger Abholcode</label>
                        <input type="text" name="code" class="form-control" maxlength="6" pattern="[0-9]{6}" placeholder="123456" required style="font-size: 1.5rem; text-align: center;" />
                    </div>
                    <button type="submit" class="btn btn-warning w-100">Uberprüfen und öffnen</button>
                </form>
            </div>
        </div>
    </div>
</div>
