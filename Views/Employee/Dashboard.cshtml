@model List<PackstationFsharp.Models.Parcel>
@{
    ViewData["Title"] = "Mitarbeiter Dashboard";
}

<h2> Mitarbeiter Dashboard</h2>
<hr />

<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.Created</h3>
                <p>Erstellt</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.InTransit</h3>
                <p>Unterwegs</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.Deposited</h3>
                <p>Eingelegt</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.AwaitingPickup</h3>
                <p>Abholbereit</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.PickedUp</h3>
                <p>Abgeholt</p>
            </div>
        </div>
    </div>
</div>

<p>
    <a asp-action="Parcels" class="btn btn-primary">Alle Pakete</a>
    <a asp-action="Deposit" class="btn btn-success">Paket einlegen</a>
    <a asp-action="Deposited" class="btn btn-info">Eingelegte Pakete</a>
    <a asp-action="AwaitingPickup" class="btn btn-warning">Abholbereite Pakete</a>
</p>

<h4>Neueste Pakete</h4>
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Tracking</th>
            <th>Absender ID</th>
            <th>Empfänger</th>
            <th>E-Mail</th>
            <th>Adresse</th>
            <th>Status</th>
            <th>Erstellt</th>
            <th>Aktion</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.TrackingNumber</strong></td>
                <td>@item.SenderUserId.Substring(0,8)</td>
                <td>@item.RecipientFullName</td>
                <td>@item.RecipientEmail</td>
                <td>@item.RecipientStreet @item.RecipientHouseNo, @item.RecipientCity</td>
                <td><span class="badge bg-secondary">@item.Status</span></td>
                <td>@item.CreatedAt.ToString("dd.MM.yy HH:mm")</td>
                <td>
                    <a asp-action="Deposit" asp-route-trackingNumber="@item.TrackingNumber" class="btn btn-sm btn-success">Einlegen</a>
                </td>
            </tr>
        }
    </tbody>
</table>
