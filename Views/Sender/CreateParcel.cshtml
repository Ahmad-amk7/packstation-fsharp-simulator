@model PackstationFsharp.Models.Parcel
@{
    ViewData["Title"] = "Paket versenden";
}

<h2>Neues Paket erstellen</h2>
<hr />

<form asp-action="CreateParcel" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    
    <h4>Empfängerdaten</h4>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="RecipientFullName" class="control-label">Name des Empfängers *</label>
                <input asp-for="RecipientFullName" class="form-control" required />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="RecipientEmail" class="control-label">E-Mail des Empfängers *</label>
                <input asp-for="RecipientEmail" class="form-control" type="email" required />
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-4">
            <div class="form-group mb-3">
                <label asp-for="RecipientStreet" class="control-label">Straße *</label>
                <input asp-for="RecipientStreet" class="form-control" required />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group mb-3">
                <label asp-for="RecipientHouseNo" class="control-label">Hausnummer *</label>
                <input asp-for="RecipientHouseNo" class="form-control" required />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="RecipientCity" class="control-label">Stadt *</label>
                <input asp-for="RecipientCity" class="form-control" required />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="RecipientPostalCode" class="control-label">Postleitzahl *</label>
                <input asp-for="RecipientPostalCode" class="form-control" required />
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="RecipientCountry" class="control-label">Land *</label>
                <input asp-for="RecipientCountry" class="form-control" required />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="RecipientPhone" class="control-label">Telefon</label>
                <input asp-for="RecipientPhone" class="form-control" />
            </div>
        </div>
    </div>
    
    <h4>Paketdaten</h4>
    <div class="form-group mb-3">
        <label asp-for="ParcelDescription" class="control-label">Paketbeschreibung</label>
        <textarea asp-for="ParcelDescription" class="form-control" rows="3"></textarea>
    </div>
    
    <div class="form-group mb-3">
        <label class="control-label">Paketbild (optional)</label>
        <input type="file" name="parcelImage" class="form-control" accept="image/*" />
    </div>
    
    <div class="form-group">
        <input type="submit" value="Paket erstellen" class="btn btn-primary" />
        <a asp-action="Dashboard" class="btn btn-secondary">Abbrechen</a>
    </div>
</form>
